<Window x:Class="Practica1_JNM.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Game - Inicio de Sesión" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0B0F17">

    <Border Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera / Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                <Border Width="12" Height="26" CornerRadius="6" Background="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="NEXUS" Foreground="#F8FAFC" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="GAME" Foreground="#38BDF8" FontSize="22" FontWeight="Black"/>
                </StackPanel>
                <TextBlock Text="Inicia sesión para continuar" Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Formulario de Entrada -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <!-- Campo Usuario -->
                <TextBlock Text="USUARIO" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,18">
                    <TextBox x:Name="txtUsuario" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                </Border>

                <!-- Campo Contraseña -->
                <TextBlock Text="CONTRASEÑA" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,18">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center"/>
                </Border>

                <!-- Mensaje Dinámico de Estado -->
                <TextBlock x:Name="lblMensaje" Text="" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <!-- Botón de Login -->
                <Border Background="#38BDF8" CornerRadius="8" Height="42" Margin="0,0,0,10">
                    <Button x:Name="btnLogin" Content="Iniciar Sesión" Background="Transparent" BorderThickness="0" Foreground="#0B0F17" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnLogin_Click"/>
                </Border>

                <!-- Botón de Salir -->
                <Border Background="#1F2937" CornerRadius="8" Height="38">
                    <Button x:Name="btnSalir" Content="Salir" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="BtnSalir_Click"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Portal de Videojuegos v2.0" Foreground="#475569" FontSize="10" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>