<Window x:Class="Practica1_JNM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal de Videojuegos - Home" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">

    <Window.Resources>

        <Style x:Key="HeaderNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" Padding="12,6" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="sideBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sideBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SidebarBtnActive" TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Background" Value="#0F2847"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">


        <Border DockPanel.Dock="Top" Height="65" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="10" Height="22" CornerRadius="5" Background="#38BDF8" Margin="0,0,12,0"/>
                    <TextBlock Text="BLIZZARD" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="TIENDA" Style="{StaticResource HeaderNavItem}"/>
                    <Button Content="COMUNIDAD" Style="{StaticResource HeaderNavItem}"/>
                    <Button Content="SOPORTE" Style="{StaticResource HeaderNavItem}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                    <TextBlock Text="mi perfil" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5">
                        <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>


        <Border DockPanel.Dock="Left" Width="180" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0" Padding="12,20">
            <StackPanel>
                <TextBlock Text="NAVEGACIÓN" Foreground="#475569" FontSize="10" FontWeight="Black" Margin="12,0,0,10"/>

                <Button Content="🔥  Destacados" Style="{StaticResource SidebarBtnActive}"/>
                <Button Content="🎮  Mis juegos" Style="{StaticResource SidebarBtn}"/>
                <Button Content="⚙️  Configuración" Style="{StaticResource SidebarBtn}"/>
            </StackPanel>
        </Border>

        
        <Border Background="#0B0F17" Padding="25">
            <StackPanel>


                <TextBlock Text="Catálogo Principal" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Explora los títulos destacados de la plataforma" Foreground="#64748B" FontSize="12" Margin="0,0,0,20"/>


                <Border BorderBrush="#1F2937" BorderThickness="1" CornerRadius="16" Background="#111827" Padding="20">
                    <WrapPanel Orientation="Horizontal">


                        <Border Width="160" Height="190" Margin="10" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#0284C7">
                                    <TextBlock Text="JUEGO" Foreground="#F8FAFC" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>


                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="0,0,11,11" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Título 01" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Destacado" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>


                        <Border Width="160" Height="190" Margin="10" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#6366F1">
                                    <TextBlock Text="JUEGO" Foreground="#F8FAFC" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="0,0,11,11" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Título 02" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Popular" Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>


                        <Border Width="160" Height="190" Margin="10" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#10B981">
                                    <TextBlock Text="JUEGO" Foreground="#F8FAFC" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="0,0,11,11" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Título 03" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Nuevo" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </WrapPanel>
                </Border>

            </StackPanel>
        </Border>

    </DockPanel>
</Window>